# NIPOST Postcode API secret key (Settings -> API Keys). Leave empty for demo mode.
POSTCODE_API_KEY=

# Optional: Africa's Talking, for real USSD/SMS (use "sandbox" while testing).
AT_USERNAME=
AT_API_KEY=

# Optional: tower used for USSD/SMS when the network does not supply one.
DEFAULT_TOWER=ABJ-WUSE
