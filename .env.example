# NIPOST Postcode API secret key (Settings -> API Keys). Leave empty for demo mode.
POSTCODE_API_KEY=

# Shared storage on Vercel: add "Upstash for Redis" under Storage and these are
# filled in for you. (On Netlify, Netlify Blobs is used automatically.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Africa's Talking, for real USSD/SMS (use "sandbox" while testing).
AT_USERNAME=
AT_API_KEY=

# Optional: tower used for USSD/SMS when the network does not supply one.
DEFAULT_TOWER=FCT-ABAJI
